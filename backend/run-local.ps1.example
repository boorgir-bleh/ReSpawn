# Copy this file to run-local.ps1 and fill in your own credentials if you want
# a different sender than the team's shared cafeotp.noreply@gmail.com (already
# committed in run-local.ps1 - you likely don't need this file at all).
# Requires `java` and `mvn` already on PATH.

$env:SMTP_HOST = "smtp.gmail.com"
$env:SMTP_PORT = "587"
$env:SMTP_USERNAME = "your-gmail-address@gmail.com"
$env:SMTP_PASSWORD = "your-16-char-app-password"   # from myaccount.google.com/apppasswords, spaces removed
$env:MAIL_FROM_ADDRESS = "your-gmail-address@gmail.com"

mvn spring-boot:run
